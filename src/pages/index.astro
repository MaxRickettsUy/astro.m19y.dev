---
import AttributionBadges from '@components/AttributionBadges.astro';
import ExternalLink from '@components/ExternalLink.astro';
import Page from '@components/Page.astro';
import Section from '@components/Section.astro';
import Layout from '@layouts/Layout.astro';

const years = [
  { href: "/rwl/2021", label: 2021 },
  { href: "/rwl/2022", label: 2022 },
  { href: "/rwl/2023", label: 2023 },
  { href: "/rwl/2024", label: 2024 }
];

const randomLinks = [
  { href: "/random/cool-sites", label: "Cool Sites" },
  { href: "/random/garden/2024", label: "Garden" },
  { href: "/random/merch-collection", label: "Merch Collection" },
  { href: "/uses", label: "Uses" }
];

const projects = [
  {
    href: "https://prsnl.site",
    label: "prsnl.site",
    description: "A curated collection of personal websites and blogs.",
    meta: "Built with Astro and Tailwind."
  },
  {
    href: "https://shoveltoss.com",
    label: "shoveltoss.com",
    description: "The official Shoveltoss website.",
    meta: "Built with Astro and Tailwind."
  }
];
---

<Layout title="m19y">
  <Page title="Welcome! I'm Max.👋🏼">
    <Section>
      <p>I'm a front-end software developer.</p>
      <p>This site is an archive of interesting articles, links, sites, and other things I've come across.</p>
      <p>Outside of software, I enjoy music, gardening, and hiking.</p>
    </Section>

    <Section title="Random 📜">
      <div class="grid gap-2 sm:grid-cols-2">
        {
          randomLinks.map((link) => (
            <a
              class="block rounded-md border border-neutral-200 p-3 text-blue-600 underline shadow-md dark:border-neutral-800 dark:text-blue-400 dark:shadow-none"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </Section>

    <Section title="Projects 🧰">
      <p>This is a list of my ongoing personal projects.</p>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          projects.map((project) => (
            <div class="space-y-1 rounded-md border border-neutral-200 p-3 shadow-md dark:border-neutral-800 dark:shadow-none">
              <ExternalLink href={project.href}>{project.label}</ExternalLink>
              <p>{project.description}</p>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">{project.meta}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section title="Read 📚 / Watch 📺 / Listen 🎧">
      <p>Different mediums indexed by year.</p>
      <div class="grid gap-2 sm:grid-cols-2">
        {
          years.map((year) => (
            <a
              class="block rounded-md border border-neutral-200 p-3 text-blue-600 underline shadow-md dark:border-neutral-800 dark:text-blue-400 dark:shadow-none"
              href={year.href}
            >
              {year.label}
            </a>
          ))
        }
      </div>
    </Section>

    <AttributionBadges />
  </Page>
</Layout>
