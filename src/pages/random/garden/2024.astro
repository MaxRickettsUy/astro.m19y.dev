---
import Page from '@components/Page.astro';
import Layout from '@layouts/Layout.astro';

import images from '@public/garden/2024.json';
import { Image } from 'astro:assets';
---

<Layout title="Garden 2024">
  <Page title="Garden 2024">
    <div class="flex flex-col flex-wrap gap-4 md:grid lg:grid xl:grid lg:grid-cols-3">
      {
        images["img"].map((image) => (
          <div class="relative lg:overflow-hidden lg:max-h-[185px]">
            <a target="_blank" rel="noopener noreferrer" href={image} title="Click to view in new tab.">
              <Image
                alt="Garden photo"
                height="500"
                width="500"
                class="rounded-lg lg:h-full lg:w-full lg:object-cover lg:object-center"
                src={image}
                loading="lazy"
              />
            </a>
          </div>
        ))
      }
    </div>
  </Page>
</Layout>
