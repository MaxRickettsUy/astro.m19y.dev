---
import Layout from '@layouts/Layout.astro';

import images from '@public/garden/2024.json';
import { Image } from 'astro:assets';
---

<Layout title="Garden 2024">
  <div class="pt-1">
    <h1 class="text-2xl pl-4 py-1">Garden 2024</h1>
    <div class="flex flex-col flex-wrap content-center md:grid lg:grid xl:grid lg:grid-cols-3 gap-4 px-4">
      {
        images["img"].map((image, i) => (
          <div class="relative lg:overflow-hidden lg:max-h-[185px]">
            <a target="_blank" rel="noopener noreferrer" href={image} title="Click to view in new tab.">
              <Image
                alt="Garden photo"
                height="500"
                width="500"
                class="lg:h-full lg:w-full lg:object-cover lg:object-center rounded-lg"
                src={image}
                loading="lazy"
              />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
