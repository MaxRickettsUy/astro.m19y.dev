---
import Page from '@components/Page.astro';
import Section from '@components/Section.astro';
import Layout from '@layouts/Layout.astro';

import images from '@public/campWood.json';
import { Image } from 'astro:assets';
---

<Layout title="Camp Wood">
  <Page title="Camp Wood">
    <Section title="Ep 1.">
      <div class="flex flex-col flex-wrap gap-4 md:grid lg:grid xl:grid lg:grid-cols-3">
        {
          images["ep1"].map((image) => (
            <div class="relative lg:overflow-hidden lg:max-h-[185px]">
              <a target="_blank" rel="noopener noreferrer" href={image} title="Click to view in new tab.">
                <Image
                  alt="Camp image"
                  height="500"
                  width="500"
                  class="lg:h-full lg:w-full lg:object-cover lg:object-center rounded-lg !p-0"
                  src={image}
                  loading="lazy"
                />
              </a>
            </div>
          ))
        }
      </div>
    </Section>
  </Page>
</Layout>
