---
import ExternalLink from "@components/ExternalLink.astro";
import Page from "@components/Page.astro";
import Section from "@components/Section.astro";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="beans">
  <Page title="Beans ☕">
    <Section title="Coffee Bean Direct - Italian Roast Espresso">
      <ExternalLink
        href="https://www.coffeebeandirect.com/collections/roasted-coffee/products/italian-roast-espresso"
      >
        <Image
          alt="Coffee Bean Direct Italian Roast Espresso"
          height="200"
          width="200"
          src="/cbd.png"
          title="Coffee Bean Direct Italian Roast Espresso"
        />
      </ExternalLink>
      <p>
        We've been using these beans for years now. Now much to compare to but
        they're pretty good.
      </p>
    </Section>
  </Page>
</Layout>
