---

<Layout title="wine night">
  <Page title="Wine Night 🍷">
    {
      sessions.map((session) => (
        <div class="space-y-2">
          <h2 class="text-lg font-semibold">{session.date}</h2>
          <div class="flex flex-col gap-2 md:flex-row lg:flex-row flex-wrap">
            {session.images.map((image) => {
              const fullSrc = isCloudinary(image.src)
                ? cldFull(image.src)
                : image.src;
              const thumbSrc = isCloudinary(image.src)
                ? cldThumb(image.src)
                : image.src;
              return (
                <div class="relative w-max">
                  <button
                    type="button"
                    class="group relative block cursor-pointer"
                    data-photo={fullSrc}
                    aria-label={`Open: ${image.alt}`}
                  >
                    <img
                      src={thumbSrc}
                      alt={image.alt}
                      width="200"
                      height="200"
                      class="rounded-md object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                    <span
                      class="absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-md bg-black/60 text-white opacity-0 ring-1 ring-white/20 transition group-hover:opacity-90"
                      aria-hidden="true"
                    >
                      <Icon name="lucide:expand" class="h-3.5 w-3.5" />
                    </span>
                  </button>
                  {image.favorite && (
                    <span class="top-[-14px] right-[-10px] absolute pointer-events-none">
                      ❤️
                    </span>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      ))
    }
  </Page>
</Layout>

<Lightbox />
