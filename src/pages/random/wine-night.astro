---
import Page from "@components/Page.astro";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
---

<Layout title="wine night">
  <Page title="Wine Night 🍷">
    <div class="space-y-2">
      <h2 class="text-lg font-semibold">03/08/2025</h2>
      <div class="flex flex-col gap-2 md:flex-row lg:flex-row">
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741830024/m19y.dev/wine-night/IMG_5981_fupitw.jpg"
        />
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741830023/m19y.dev/wine-night/IMG_5979_j9xclo.jpg"
        />
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741830023/m19y.dev/wine-night/IMG_5980_buoyse.jpg"
        />
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741830022/m19y.dev/wine-night/IMG_5983_yyzzw2.jpg"
        />
        <div class="relative w-max">
          <Image
            alt="Wine night photo (favorite)"
            width="200"
            height="200"
            src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741830022/m19y.dev/wine-night/IMG_5982_yyzzw2.jpg"
          />
          <span class="top-[-14px] right-[-10px] absolute">❤️</span>
        </div>
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741830021/m19y.dev/wine-night/IMG_5984_z8ahoc.jpg"
        />
      </div>
    </div>
    <div class="space-y-2">
      <h2 class="text-lg font-semibold">10/26/2024</h2>
      <div class="flex flex-col gap-2 md:flex-row lg:flex-row">
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741829338/m19y.dev/wine-night/IMG_5540_ktmx3u.jpg"
        />
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741829339/m19y.dev/wine-night/IMG_5541_dmqlyl.jpg"
        />
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741829338/m19y.dev/wine-night/IMG_5542_rofryy.jpg"
        />
        <Image
          alt="Wine night photo"
          width="200"
          height="200"
          src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1741830024/m19y.dev/wine-night/IMG_5543_iourb9.jpg"
        />
      </div>
    </div>
    <div class="space-y-2">
      <h2 class="text-lg font-semibold">04/20/2024</h2>
      <div class="flex flex-col gap-2 md:flex-row lg:flex-row">
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.totalwine.com/wine/red-wine/red-blend/prats-symington-post-scriptum-douro/p/2126239163?s=401&igrules=true"
        >
          <Image
            alt="Prats & Symington Post Scriptum Douro"
            width="200"
            height="200"
            src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1714353623/m19y.dev/wine-night/IMG_4839_lfumhs.webp"
          />
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://torbreck.com/products/woodcutters-shiraz"
        >
          <Image
            alt="Torbreck Woodcutters Shiraz"
            width="200"
            height="200"
            src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1714353623/m19y.dev/wine-night/IMG_4841_ybws1k.webp"
          />
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.wine.com/product/venus-la-universal-dido-red-blend-2021/1405386"
        >
          <Image
            alt="Venus La Universal Dido Red Blend 2021"
            width="200"
            height="200"
            src="https://res.cloudinary.com/shoveltoss-com/image/upload/v1714353622/m19y.dev/wine-night/IMG_4840_snb5jg.webp"
          />
        </a>
      </div>
    </div>
    <div class="space-y-2">
      <h2 class="text-lg font-semibold">11/11/2023</h2>
      <div class="flex flex-col gap-2 md:flex-row lg:flex-row">
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.totalwine.com/wine/white-wine/gruner-veltliner/gruber-roschitz-gruner-veltliner-dac-muhlberg/p/120233750"
        >
          <Image
            alt="Gruber Roschitz Gruner Veltliner DAC Muhlberg"
            height="200"
            width="200"
            src="https://www.totalwine.com/dynamic/x1000,sq/media/sys_master/twmmedia/h3d/hb1/8805988139038.png"
            title="Gruber Roschitz Gruner Veltliner DAC Muhlberg"
          />
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.totalwine.com/wine/red-wine/rhone-blend/pierre-amadieu-gigondas-pas-de-laigle-grande-reserve/p/35365750?s=&igrules=true"
        >
          <Image
            alt="Pierre Amadieu Gigondas Pas De L'Aigle Grande Reserve, 2018"
            height="200"
            width="200"
            src="https://www.totalwine.com/dynamic/x1000,sq/media/sys_master/twmmedia/hb1/h57/10140738945054.png"
            title="Pierre Amadieu Gigondas Pas De L'Aigle Grande Reserve, 2018"
          />
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.totalwine.com/wine/red-wine/aglianico/donnachiara-taurasi-aglianico/p/129852750"
        >
          <Image
            alt="Donnachiara Taurasi Aglianico"
            height="200"
            width="200"
            src="https://www.totalwine.com/dynamic/x1000,sq/media/sys_master/twmmedia/h9e/ha1/11524016603166.png"
            title="Donnachiara Taurasi Aglianico"
          />
        </a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://www.totalwine.com/wine/red-wine/tempranillo/la-rioja-alta-vina-ardanza-reserva/p/36816750?s=401&igrules=true"
        >
          <Image
            alt="La Rioja Alta Vina Ardanza Reserva, 2015"
            height="200"
            width="200"
            src="https://www.totalwine.com/dynamic/x1000,sq/media/sys_master/twmmedia/h8d/h4d/17335518363678.png"
            title="La Rioja Alta Vina Ardanza Reserva, 2015"
          />
        </a>
      </div>
    </div>
  </Page>
</Layout>
