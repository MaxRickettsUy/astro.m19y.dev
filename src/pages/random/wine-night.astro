---
import { Icon } from "astro-icon/components";
import Lightbox from "@components/Lightbox.astro";
import Page from "@components/Page.astro";
import Layout from "@layouts/Layout.astro";

const cloudinaryPath = "/image/upload/";

const cldThumb = (url: string) =>
  url.replace(
    cloudinaryPath,
    `${cloudinaryPath}f_auto,q_auto,dpr_auto,c_fill,w_400/`,
  );

const cldFull = (url: string) =>
  url.replace(cloudinaryPath, `${cloudinaryPath}f_auto,q_auto,dpr_auto,w_1600/`);

const isCloudinary = (url: string) => url.includes(cloudinaryPath);

interface WineImage {
  src: string;
  alt: string;
  favorite?: boolean;
}

interface Session {
  date: string;
  images: WineImage[];
}

