---
export interface Props {
  audiobook?: boolean,
  complete?: boolean,
  label: string,
  href: string,
  inProgress?: boolean,
  wiki?: boolean
}

const { audiobook, complete, inProgress, label, wiki } = Astro.props;
let { href } = Astro.props;

wiki ? href = `https://en.wikipedia.org/wiki/${href}` : href;
---

<div class="lg:text-md text-md my-1 flex flex-row">
  <a class="italic mr-1" target="_blank" rel="noopener noreferrer" href={href}>{label}</a>
  { inProgress ? <span class="mr-1">⏳</span> : null}
  { complete ? <span class="mr-1">☑️</span> : null}
  { audiobook ? <span>🎧</span> : null}
</div>
