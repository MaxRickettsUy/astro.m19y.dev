---
import { Icon } from 'astro-icon/components';

export interface Props {
  href: string;
  class?: string;
  icon?: boolean;
}

const { href, class: className = '', icon = false } = Astro.props;
---

<a
  class:list={[
    'inline-flex items-center gap-1 text-blue-600 underline dark:text-blue-400',
    className
  ]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
  {icon && <Icon name="lucide:arrow-up-right" class="w-4 h-4 shrink-0" aria-hidden="true" />}
</a>
