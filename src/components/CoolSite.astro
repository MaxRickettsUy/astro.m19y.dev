---
export interface Site {
  github?: string;
  name: string;
  img: string;
  href: string;
  rss?: string;
}

export interface Props {
  site?: Site;
  star?: boolean;
  inactive?: boolean;
  archived?: boolean;
}

import { Icon } from 'astro-icon/components';

import Badge from '@components/Badge.astro';
import ExternalLink from '@components/ExternalLink.astro';

const { archived, site, star, inactive } = Astro.props;
---

<div class="p-3 space-y-2 border border-dashed rounded-md shadow-md border-neutral-200 dark:border-neutral-700 dark:shadow-none">
  <div class="flex flex-row justify-between">
    <div class="flex flex-row gap-1 items-center">
      <div class="flex flex-row">
        <ExternalLink href={site.href} class="mr-1" icon>
          <h3 class="text-lg font-semibold">{site.name}</h3>
        </ExternalLink>
      </div>
      { site.github &&
        <a class="text-neutral-700 dark:text-neutral-300" target="_blank" rel="noopener noreferrer" href={site.github} aria-label={`${site.name} GitHub`}>
          <Icon name="lucide:github" class="w-4 h-4" aria-hidden="true" />
        </a>
      }
      { site.rss &&
        <a class="text-neutral-700 dark:text-neutral-300" href={site.rss} aria-label={`${site.name} RSS feed`}>
          <Icon name="lucide:rss" class="w-4 h-4" aria-hidden="true" />
        </a>
      }
    </div>
    { inactive && <Badge color="gray" label="Inactive"></Badge> }
    { archived && <Badge color="gray" label="Archived"></Badge> }
    { star && <span>⭐</span>}
  </div>
  <img class="w-full p-1 my-1 border border-dashed rounded-lg border-neutral-200 bg-white dark:border-neutral-700 dark:bg-neutral-900" src={site.img} alt={site.name} />
  <div class="space-y-2">
    <slot></slot>
  </div>
</div>
