---
interface Article {
  archive: string;
  href: string;
  label: string;
}

export interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<div class="my-1">
  <a
    class="text-blue-600 underline dark:text-blue-400"
    target="_blank"
    rel="noopener noreferrer"
    href={article.href}
  >
    <i>{article.label}</i>
  </a>
  [<a
    class="archive text-xs underline"
    target="_blank"
    rel="noopener noreferrer"
    href={article.archive}>archive</a
  >]
</div>
